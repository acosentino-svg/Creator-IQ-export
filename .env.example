# Copy this file to .env and fill in your real values.
# Never commit the real .env file (it is already git-ignored).

# --- CreatorIQ API ---
# Base URL of your CreatorIQ API instance (ask your CreatorIQ CSM / see apidocs.creatoriq.com).
CREATORIQ_BASE_URL=https://api.creatoriq.com/api
# CRM Reports API (Active Members, Daily Campaign Posts) — uses x-api-key header.
CREATORIQ_CRM_BASE_URL=https://apis.creatoriq.com/crm/v1
# API key / bearer token issued to your org.
CREATORIQ_API_KEY=replace-me
# Some CreatorIQ tenants require an org/account identifier on every request.
CREATORIQ_ORG_ID=replace-me

# --- App behavior ---
# "demo" uses bundled synthetic data (no API calls, safe for local exploration).
# "live" pulls real data from CreatorIQ via the API client + local cache DB.
CREATORIQ_DASHBOARD_MODE=demo

# Local cache database (SQLite) used by the dashboard so pages load instantly
# instead of hitting the CreatorIQ API on every view.
CREATORIQ_DB_PATH=data/warehouse.db

# Optional: OpenAI API key for the Chat Assistant's flexible NL parser.
# Without this, the built-in rule-based parser still handles common questions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Slack Incoming Webhook URL to post weekly "needs attention" digests.
SLACK_WEBHOOK_URL=
